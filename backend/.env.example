# Servidor
PORT=3000
NODE_ENV=development
ADMIN_SESSION_SECRET=cambia-esta-clave-por-una-aleatoria
# Se usa únicamente para generar el hash irreversible de la IP de cada voto.
POLL_IP_SECRET=cambia-esta-clave-por-otra-aleatoria
# Hostinger/Passenger usa normalmente un proxy delante de Node.
TRUST_PROXY_HOPS=1

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=liga_simracing

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Tiempos en vivo y alertas SMTP
LIVE_TIMING_HOST=rh.servegame.com
CLUB_SERVER_MANAGER_URL=http://rh.servegame.com:30000/
LIVE_MONITOR_EMAIL=fede.cabello@hotmail.com
LIVE_MONITOR_INTERVAL_MS=15000
LIVE_MONITOR_OUTAGE_MS=60000
LIVE_MONITOR_TIMEOUT_MS=25000
LIVE_MONITOR_ALERT_COOLDOWN_MS=1800000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASSWORD=
SMTP_FROM="CADPO <usuario@example.com>"

# Asistente IA Ayrton (Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=tu_account_id_de_cloudflare
CLOUDFLARE_AI_API_TOKEN=tu_token_de_workers_ai
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_TIMEOUT_MS=30000
AYRTON_REQUESTS_PER_MINUTE=12
# Historial de Ayrton en Cloudflare D1. El token separado es opcional si el de IA también tiene permiso D1 Edit.
CLOUDFLARE_D1_DATABASE_ID=tu_database_id_de_d1
CLOUDFLARE_D1_API_TOKEN=tu_token_de_d1
AYRTON_IP_SECRET=cambia-esta-clave-por-una-aleatoria
# Notificación por cada respuesta usando la configuración SMTP general.
AYRTON_EMAIL_NOTIFICATIONS=true
AYRTON_NOTIFY_EMAIL=fede.cabello@hotmail.com
